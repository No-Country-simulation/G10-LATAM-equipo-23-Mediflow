# Copie este arquivo para .env na raiz.

# Credenciais locais legadas e opções de autenticação.
MEDIFLOW_USERNAME=operador
MEDIFLOW_PASSWORD_HASH=
MEDIFLOW_AUTH_SECRET=
MEDIFLOW_ROLE=operador
MEDIFLOW_AUTH_SESSION_DB=backend/data/auth_sessions.sqlite3
MEDIFLOW_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
MEDIFLOW_LOCAL_DEMO_MODE=true

# Configuração do agente e do armazenamento.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MEDIFLOW_STORAGE_BACKEND=local
MEDIFLOW_LOCAL_STORAGE_DIR=
STORAGE_ENCRYPTION_KEY=
MEDIFLOW_NER_MODEL=pt_core_news_sm
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=
